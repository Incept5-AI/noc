# /opt/noc/.env  — loaded by systemd (EnvironmentFile). No `export`, no quotes needed.
APP_NAME=Fleet NOC
# Every sign-in link is built from this — must be the public origin.
APP_BASE_URL=https://noc.example.com
# Who may sign in (comma-separated). Empty = nobody.
ALLOWED_EMAIL_DOMAINS=example.com
# Who sees every machine, the power controls on all of them, and /admin.
ADMIN_EMAILS=you@example.com
# A verified Amazon SES identity, and its region.
SES_SENDER=noc@example.com
AWS_REGION=eu-west-2
# Do NOT set AWS_PROFILE (an empty value breaks botocore) — boto3 uses the instance role.
NOC_DB=/opt/noc/noc.db
COOKIE_SECURE=1
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15
# Shared secret agents may use in POST /report?token=... — set to a long random string.
# (Machines enrolled through /add get their own per-machine token instead.)
NOC_TOKEN=CHANGE_ME
# Optional, for the admin network page: your home LAN and the upstream LAN between the
# mesh router and the ISP gateway (only matters with double NAT).
#NOC_MESH_LAN=192.168.50.0/24
#NOC_WAN_LAN=192.168.1.0/24
